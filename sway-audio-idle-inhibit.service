[Unit]
Description=Prevents system from idling when there's an active audio source or sink

BindsTo=graphical-session.target
PartOf=graphical-session.target
After=graphical-session.target

# The unit is enabled for every graphical session (graphical-session.target),
# so without this it would also run in GNOME sessions and in the login screen.
# Both Regolith sessions use it: the inhibitor is taken through gnome-session,
# whose idle inhibitors pause idle in the X11 session (GNOME Flashback) and in
# the Wayland session (regolith-powerd's swayidle).
ConditionEnvironment=|XDG_SESSION_DESKTOP=regolith-wayland
ConditionEnvironment=|XDG_SESSION_DESKTOP=regolith-x11

[Service]
ExecStart=/usr/bin/sway-audio-idle-inhibit
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
